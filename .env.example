# Mastra Second Brain - Environment Variables
# Copy to .env and fill in your values

# Database (PostgreSQL with pgvector on the same server)
DATABASE_URL=postgresql://mastra:YOUR_PASSWORD@127.0.0.1:5432/mastra

# Redis (for future rate limiting / caching)
REDIS_URL=redis://:YOUR_PASSWORD@127.0.0.1:6379/0

# LLM API Keys
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Optional: OpenRouter for MiniMax and other models
# OPENROUTER_API_KEY=sk-or-...

# MCP: GitHub integration
GITHUB_TOKEN=ghp_...

# MCP: Filesystem root directory
FS_ROOT=/opt/mastra/data

# Server
PORT=4111
MASTRA_HOST=0.0.0.0
NODE_ENV=production
